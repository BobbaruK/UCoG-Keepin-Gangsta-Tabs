// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// AUTH

enum UserRole {
  USER
  ADMIN
  OWNER
}

model auth_user {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  name             String
  firstName        String
  lastName         String
  slug             String    @unique
  username         String    @unique
  displayUsername  String    @unique
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  bio              String?
  role             UserRole  @default(USER)
  banned           Boolean?  @default(false)
  banReason        String?
  banExpires       DateTime?
  twoFactorEnabled Boolean?  @default(false)
  isAccountVisible Boolean?  @default(true)
  lastLoginMethod  String?
  lastLoginAt      DateTime  @default(now())

  sessions   auth_session[]
  accounts   auth_account[]
  twofactors auth_two_factor[]

  cogPlaythroughs   cog_playthrough[]
  cogPoliceOfficers cog_police_officer[]
  cogCrewMembers    cog_crew_member[]

  @@index([email, slug])
  @@map("user")
}

model auth_session {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?

  userId String
  user   auth_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, token])
  @@map("session")
}

model auth_account {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  userId String
  user   auth_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model auth_verification {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  identifier String
  value      String
  expiresAt  DateTime

  @@index([identifier])
  @@map("verification")
}

model auth_two_factor {
  id String @id @unique @default(cuid())

  secret      String
  backupCodes String
  userId      String

  auth_user auth_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@map("two_factor")
}

// COG APP

//    Base Tables

enum SideEffectType {
  MOVEMENT
  ACTION
}

model cog_side_effect {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String         @unique
  description String?
  type        SideEffectType @default(MOVEMENT)
  value       Int

  cog_trait         cog_trait[]
  cog_laws          cog_law[]
  cog_captain_roles cog_captain_role[]
}

model cog_trait {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String  @unique
  description String?
  image       String?

  sideEffect        cog_side_effect?  @relation(fields: [cog_side_effectId], references: [id])
  cog_side_effectId String?
  cogCrewMember     cog_crew_member[]
}

enum LawType {
  TEMPORARY
  PERMANENT
}

model cog_law {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String  @unique
  description String?
  enact       Int
  revoke      Int
  type        LawType @default(PERMANENT)

  sideEffect        cog_side_effect? @relation(fields: [cog_side_effectId], references: [id])
  cog_side_effectId String?

  playthroughs cog_playthrough[]
}

model cog_nationality {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name         String            @unique
  description  String?
  flag         String?
  crew_members cog_crew_member[]
}

model cog_vehicle_type {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name     String @unique
  capacity Int
}

enum ResourceCategory {
  INGREDIENTS
  ALCOHOLS
  WEAPONS
  MATERIALS
  OTHERS
}

model cog_resource {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name     String           @unique
  image    String?
  category ResourceCategory @default(INGREDIENTS)
  price    Int

  resource_type       cog_resource_type @relation(fields: [cog_resource_typeId], references: [id])
  cog_resource_typeId String
}

model cog_resource_type {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name         String         @unique
  capacity     Int
  cogResources cog_resource[]
}

model cog_captain_role {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String  @unique
  image       String?
  description String?

  sideEffect        cog_side_effect? @relation(fields: [cog_side_effectId], references: [id], onDelete: SetDefault)
  cog_side_effectId String?

  crew_members cog_crew_member[]
}

enum CrewLevelType {
  DRIVER
  GAMBLING
  GENERAL
  PRODUCTION
  SPEAKEASY
}

model cog_crew_level {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type        CrewLevelType @default(DRIVER)
  name        String        @unique
  max_level   Int
  description String?
}

// Main Table

model cog_playthrough {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name                   String
  seed                   String?
  passenger_rail_station Boolean @default(false)
  freight_rail_station   Boolean @default(false)
  respect_for_the_law    Boolean @default(false)
  is_public              Boolean @default(false)

  laws cog_law[]

  police_officers cog_police_officer[]
  crew_members    cog_crew_member[]
  // buildings
  // gambling_buildings
  // auto_routes
  // wards
  user            auth_user            @relation(fields: [auth_userId], references: [id], onDelete: Cascade)
  auth_userId     String
}

// Police

model cog_police_officer {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name                        String
  bribed_turn                 Int
  has_rival_hooligan_relative Boolean @default(false)
  political_contact_used      Boolean @default(false)
  can_call_in_a_raid          Boolean @default(false)

  cogPlaythrough    cog_playthrough? @relation(fields: [cog_playthroughId], references: [id], onDelete: Cascade)
  cog_playthroughId String?
  user              auth_user        @relation(fields: [auth_userId], references: [id], onDelete: Cascade)
  auth_userId       String
}

// Crew

model cog_crew_member {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  first_name           String
  last_name            String
  full_name            String
  alias                String
  is_boss              Boolean @default(false)
  is_dead              Boolean @default(false)
  turn_recruited       Int
  // base leveling
  driver               Int
  opportunist          Int
  brawler              Int
  // driver leveling
  door_dash            Int
  alley_ace            Int
  // gambling leveling
  house_manager        Int
  mechanically_minded  Int
  pit_boss             Int
  // booze production leveling
  production_manager   Int
  booze_manufacture    Int
  booze_upgrade        Int
  methodical_organizer Int
  // speakeasy
  counter_chin_wagger  Int
  speakeasy_manager    Int

  captain            cog_captain_role? @relation(fields: [cog_captain_roleId], references: [id])
  cog_captain_roleId String?
  nationality        cog_nationality   @relation(fields: [cog_nationalityId], references: [id])
  cog_nationalityId  String
  traits             cog_trait[]
  playthrough        cog_playthrough   @relation(fields: [cog_playthroughId], references: [id])
  cog_playthroughId  String
  user               auth_user         @relation(fields: [auth_userId], references: [id], onDelete: Cascade)
  auth_userId        String

  @@index([full_name])
}
