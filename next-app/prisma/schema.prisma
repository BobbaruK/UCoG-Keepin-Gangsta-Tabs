// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// AUTH

enum UserRole {
  USER
  ADMIN
  OWNER
}

model auth_user {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  name             String
  firstName        String
  lastName         String
  slug             String    @unique
  username         String    @unique
  displayUsername  String    @unique
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  bio              String?
  role             UserRole  @default(USER)
  banned           Boolean?  @default(false)
  banReason        String?
  banExpires       DateTime?
  twoFactorEnabled Boolean?  @default(false)
  isAccountVisible Boolean?  @default(true)
  lastLoginMethod  String?
  lastLoginAt      DateTime  @default(now())

  sessions   auth_session[]
  accounts   auth_account[]
  twofactors auth_two_factor[]

  cogPlaythroughs      cog_playthrough[]
  cogPoliceOfficers    cog_police_officer[]
  cogCrewMembers       cog_crew_member[]
  cogAutoRoutes        cog_auto_route[]
  cogBuildings         cog_building[]
  cogGamblingBuildings cog_gambling_building[]

  @@index([email, slug])
  @@map("user")
}

model auth_session {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?

  userId String
  user   auth_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, token])
  @@map("session")
}

model auth_account {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  userId String
  user   auth_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model auth_verification {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  identifier String
  value      String
  expiresAt  DateTime

  @@index([identifier])
  @@map("verification")
}

model auth_two_factor {
  id String @id @unique @default(cuid())

  secret      String
  backupCodes String
  userId      String

  auth_user auth_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@map("two_factor")
}

// COG APP

//    Base Tables

enum SideEffectType {
  MOVEMENT
  ACTION
}

model cog_side_effect {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String         @unique
  description String?
  type        SideEffectType @default(MOVEMENT)
  value       Int

  cog_trait         cog_trait[]
  cog_laws          cog_law[]
  cog_captain_roles cog_captain_role[]
}

model cog_trait {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String  @unique
  description String?
  image       String?

  sideEffect        cog_side_effect?  @relation(fields: [cog_side_effectId], references: [id])
  cog_side_effectId String?
  cogCrewMember     cog_crew_member[]
}

enum LawType {
  TEMPORARY
  PERMANENT
}

model cog_law {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String  @unique
  description String?
  enact       Int
  revoke      Int
  type        LawType @default(PERMANENT)

  sideEffect        cog_side_effect? @relation(fields: [cog_side_effectId], references: [id])
  cog_side_effectId String?

  playthroughs cog_playthrough[]
}

model cog_nationality {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name         String            @unique
  description  String?
  flag         String?
  crew_members cog_crew_member[]
}

model cog_vehicle_type {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name     String @unique
  capacity Int

  cogAutoRoutes cog_auto_route[]
}

enum ResourceCategory {
  INGREDIENTS
  ALCOHOLS
  WEAPONS
  MATERIALS
  OTHERS
}

model cog_resource {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name     String           @unique
  image    String?
  category ResourceCategory @default(INGREDIENTS)
  price    Int

  resource_type       cog_resource_type                 @relation(fields: [cog_resource_typeId], references: [id])
  cog_resource_typeId String
  passive_productions cog_building_passive_production[]
}

model cog_resource_type {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name         String         @unique
  capacity     Int
  cogResources cog_resource[]
}

//    Main Table

model cog_playthrough {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name                   String
  seed                   String?
  passenger_rail_station Boolean @default(false)
  freight_rail_station   Boolean @default(false)
  respect_for_the_law    Boolean @default(false)
  is_public              Boolean @default(false)
  is_finished            Boolean @default(false)

  laws cog_law[]

  police_officers    cog_police_officer[]
  crew_members       cog_crew_member[]
  buildings          cog_building[]
  gambling_buildings cog_gambling_building[]
  auto_routes        cog_auto_route[]
  // wards
  user               auth_user               @relation(fields: [auth_userId], references: [id], onDelete: Cascade)
  auth_userId        String
}

//    Police

model cog_police_officer {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name                        String
  bribed_turn                 Int
  has_rival_hooligan_relative Boolean @default(false)
  political_contact_used      Boolean @default(false)
  can_call_in_a_raid          Boolean @default(false)

  cogPlaythrough    cog_playthrough @relation(fields: [cog_playthroughId], references: [id], onDelete: Cascade)
  cog_playthroughId String
  user              auth_user       @relation(fields: [auth_userId], references: [id], onDelete: Cascade)
  auth_userId       String
}

//    Crew

model cog_crew_member {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  first_name     String
  last_name      String
  full_name      String
  alias          String?
  is_boss        Boolean               @default(false)
  is_dead        Boolean               @default(false)
  turn_recruited Int
  experience     cog_crew_experience[]

  captain            cog_captain_role? @relation(fields: [cog_captain_roleId], references: [id])
  cog_captain_roleId String?

  nationality       cog_nationality @relation(fields: [cog_nationalityId], references: [id])
  cog_nationalityId String

  traits cog_trait[]

  playthrough       cog_playthrough @relation(fields: [cog_playthroughId], references: [id], onDelete: Cascade)
  cog_playthroughId String

  user        auth_user @relation(fields: [auth_userId], references: [id], onDelete: Cascade)
  auth_userId String

  cogAutoRoute        cog_auto_route?
  cogBuildings        cog_building?
  cogGamblingBuilding cog_gambling_building?

  @@index([full_name])
}

model cog_crew_experience {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  value Int

  level             cog_crew_level  @relation(fields: [cog_crew_levelId], references: [id])
  cog_crew_levelId  String
  cogCrewMember     cog_crew_member @relation(fields: [cog_crew_memberId], references: [id], onDelete: Cascade)
  cog_crew_memberId String
}

model cog_captain_role {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String  @unique
  image       String?
  description String?

  sideEffect        cog_side_effect? @relation(fields: [cog_side_effectId], references: [id], onDelete: SetDefault)
  cog_side_effectId String?

  crew_members cog_crew_member[]
}

enum CrewLevelType {
  DRIVER
  GAMBLING
  GENERAL
  PRODUCTION
  SPEAKEASY
}

model cog_crew_level {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  type        CrewLevelType @default(DRIVER)
  name        String
  max_level   Int
  description String?

  cogCrewExperiences cog_crew_experience[]
}

//    Auto Routes

model cog_auto_route {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name  String @unique
  steps Int

  crew_member    cog_crew_member? @relation(fields: [crew_member_id], references: [id])
  crew_member_id String?          @unique

  vehicle_type       cog_vehicle_type? @relation(fields: [cog_vehicle_typeId], references: [id])
  cog_vehicle_typeId String?

  route_type cog_auto_route_type[]

  playthrough       cog_playthrough @relation(fields: [cog_playthroughId], references: [id], onDelete: Cascade)
  cog_playthroughId String

  user        auth_user @relation(fields: [auth_userId], references: [id], onDelete: Cascade)
  auth_userId String
}

model cog_auto_route_type {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String @unique

  cogAutoRoute cog_auto_route[]
}

//    Buildings

model cog_building {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String @unique

  manager    cog_crew_member? @relation(fields: [manager_id], references: [id])
  manager_id String?          @unique

  type    cog_building_type? @relation(fields: [type_id], references: [id])
  type_id String?

  size    cog_building_size @relation(fields: [size_id], references: [id])
  size_id String

  passive_productions cog_building_passive_production[]

  passive_productions_duration   cog_building_passive_production_duration? @relation(fields: [passive_production_duration_id], references: [id])
  passive_production_duration_id String?

  backroom    cog_building_backroom? @relation(fields: [backroom_id], references: [id])
  backroom_id String?

  playthrough    cog_playthrough @relation(fields: [playthrough_id], references: [id], onDelete: Cascade)
  playthrough_id String

  user    auth_user @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String
}

model cog_building_type {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String @unique

  buildings cog_building[]
}

model cog_building_size {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name     String @unique
  capacity Int

  buildings cog_building[]
}

model cog_building_backroom {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String @unique

  buildings cog_building[]
}

model cog_building_passive_production {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quantity Int

  resource   cog_resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)
  resourceId String?

  buildings cog_building[]
}

model cog_building_passive_production_duration {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name  String @unique
  turns Int

  buildings cog_building[]
}

//    Gambling

model cog_gambling_building {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name String @unique

  gambling_building_size    cog_gambling_size @relation(fields: [gambling_building_size_id], references: [id])
  gambling_building_size_id String

  manager    cog_crew_member @relation(fields: [manager_id], references: [id])
  manager_id String          @unique

  playthrough    cog_playthrough @relation(fields: [playthrough_id], references: [id], onDelete: Cascade)
  playthrough_id String

  features cog_gambling_feature[]

  user    auth_user @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id String
}

enum GamblingFeatureType {
  ENHANCED
  OCCASIONAL
  REGULAR
}

model cog_gambling_feature {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name         String
  weekly_cost  Int
  cash_on_hand Int
  is_dlc       Boolean             @default(false)
  type         GamblingFeatureType @default(OCCASIONAL)

  buildings cog_gambling_building[]
}

model cog_gambling_size {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name         String
  max_features Int
  is_dlc       Boolean @default(false)

  gambling_buildings cog_gambling_building[]
}
