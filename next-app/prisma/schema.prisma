generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// AUTH

enum UserRole {
  USER
  ADMIN
  OWNER
}

model auth_user {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  name             String
  firstName        String
  lastName         String
  slug             String    @unique
  username         String    @unique
  displayUsername  String    @unique
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  bio              String?
  role             UserRole  @default(USER)
  banned           Boolean?  @default(false)
  banReason        String?
  banExpires       DateTime?
  twoFactorEnabled Boolean?  @default(false)
  isAccountVisible Boolean?  @default(true)
  lastLoginMethod  String?
  lastLoginAt      DateTime  @default(now())

  sessions   auth_session[]
  accounts   auth_account[]
  twofactors auth_two_factor[]

  @@index([email, slug])
  @@map("user")
}

model auth_session {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expiresAt      DateTime
  token          String   @unique
  ipAddress      String?
  userAgent      String?
  impersonatedBy String?

  userId String
  user   auth_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, token])
  @@map("session")
}

model auth_account {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?

  userId String
  user   auth_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model auth_verification {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  identifier String
  value      String
  expiresAt  DateTime

  @@index([identifier])
  @@map("verification")
}

model auth_two_factor {
  id String @id @unique @default(cuid())

  secret      String
  backupCodes String
  userId      String

  auth_user auth_user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([secret])
  @@map("two_factor")
}

// COG APP

enum SideEffectType {
  MOVEMENT
  ACTION
}

model cog_side_effect {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String         @unique
  description String?
  type        SideEffectType @default(MOVEMENT)
  value       Int

  cog_trait cog_trait[]
  cog_laws  cog_law[]
}

model cog_trait {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String  @unique
  description String?
  image       String?

  sideEffect        cog_side_effect? @relation(fields: [cog_side_effectId], references: [id])
  cog_side_effectId String?
}

enum LawType {
  TEMPORARY
  PERMANENT
}

model cog_law {
  id        String   @id @unique @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  name        String  @unique
  description String?
  enact       Int
  revoke      Int
  type        LawType @default(PERMANENT)

  sideEffect        cog_side_effect? @relation(fields: [cog_side_effectId], references: [id])
  cog_side_effectId String?
}
